{
  "name": "pydong",
  "version": "1.2.0",
  "type": "module",
  "description": "Pydong technical articles built with Astro.",
  "license": "MIT",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist --output-subdir _pagefind",
    "preview": "astro preview",
    "astro": "astro",
    "pagefind": "pagefind --site dist --output-subdir _pagefind",
    "typecheck": "astro check",
    "test": "bun test ./node_modules/@tsche/astro-blog-theme/src",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{astro,ts,tsx,js,jsx,md,mdx,css,json}\"",
    "format:check": "prettier --check \"**/*.{astro,ts,tsx,js,jsx,md,mdx,css,json}\""
  },
  "dependencies": {
    "@tsche/astro-blog-theme": "git+https://github.com/tsche/astro-theme.git#master",
    "astro": "^7.0.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@eslint/js": "^10.0.1",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/source-sans-3": "5.3.0",
    "@iconify-json/lucide": "^1.2.115",
    "@types/bun": "^1.3.14",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "eslint": "^10.6.0",
    "eslint-plugin-astro": "^3.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.4",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "astro",
    "tailwindcss",
    "daisyui",
    "mdx",
    "pagefind",
    "giscus",
    "blog"
  ]
}
